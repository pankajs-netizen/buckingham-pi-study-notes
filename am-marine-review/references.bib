@article{pereira_antifouling_2020,
title = {Antifouling {Napyradiomycins} from {Marine}-{Derived} {Actinomycetes} {Streptomyces} aculeolatus},
  volume = {18},
  issn = {1660-3397},
  url = {https://www.mdpi.com/1660-3397/18/1/63},
  doi = {10.3390/md18010063},
  abstract = {The undesired attachment of micro and macroorganisms on water-immersed surfaces, known as marine biofouling, results in severe prevention and maintenance costs (billions €/year) for aquaculture, shipping and other industries that rely on coastal and off-shore infrastructures. To date, there are no sustainable, cost-effective and environmentally safe solutions to address this challenging phenomenon. Therefore, we investigated the antifouling activity of napyradiomycin derivatives that were isolated from actinomycetes from ocean sediments collected off the Madeira Archipelago. Our results revealed that napyradiomycins inhibited ≥80\% of the marine biofilm-forming bacteria assayed, as well as the settlement of Mytilus galloprovincialis larvae (EC50 {\textless} 5 µg/ml and LC50/EC50 {\textgreater}15), without viability impairment. In silico prediction of toxicity end points are of the same order of magnitude of standard approved drugs and biocides. Altogether, napyradiomycins disclosed bioactivity against marine micro and macrofouling organisms, and non-toxic effects towards the studied species, displaying potential to be used in the development of antifouling products.},
  language = {en},
  number = {1},
  urldate = {2026-09-06},
  journal = {Marine Drugs},
  author = {Pereira, Florbela and Almeida, Joana R. and Paulino, Marisa and Grilo, Inês R. and Macedo, Helena and Cunha, Isabel and Sobral, Rita G. and Vasconcelos, Vitor and Gaudêncio, Susana P.},
  month = jan,
  year = {2020},
  pages = {63},
  file = {Submitted Version:C\:\\Users\\Priyanka\\Zotero\\storage\\HZ3NXPXD\\Pereira et al. - 2020 - Antifouling Napyradiomycins from Marine-Derived Actinomycetes Streptomyces aculeolatus.pdf:application/pdf}
}

